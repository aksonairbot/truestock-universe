# -----------------------------------------------------------------------------
# Truestock Universe — environment variables
# Copy to `.env` (repo root) for local dev. On DO App Platform, set these as
# per-component env vars, not as a file.
# -----------------------------------------------------------------------------

# Postgres connection (DO Managed Postgres)
# Local docker: postgres://postgres:postgres@localhost:5432/truestock
# Managed: postgres://doadmin:xxxxx@db-xxxxx.do-user-xxxxx.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_URL="postgres://postgres:postgres@localhost:5432/truestock"

# NextAuth signing secret. REQUIRED — the app and the middleware both refuse to
# start without it. Also the key behind signed media links (see below).
# Generate: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Razorpay credentials (get from dashboard.razorpay.com)
# Use TEST keys locally (rzp_test_...), LIVE keys in prod only
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Webhook secret — set a strong random string here AND in Razorpay dashboard
# (Razorpay → Settings → Webhooks → add webhook → enter this as the secret)
RAZORPAY_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# Internal sync auth — protects the /api/sync/* endpoints
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET="change-me-to-a-long-random-string"

# Cron auth — every /api/cron/* route checks this against the x-cron-secret
# header (or ?secret=). Without it those routes return 500 and do nothing.
# Generate: openssl rand -hex 32
CRON_SECRET="change-me-to-a-long-random-string"

# App URL. Must be the PUBLIC https URL in production — signed media links for
# the social publisher are built from it, and a wrong value means Upload-post
# cannot fetch the images.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Where task attachments are written on disk.
UPLOADS_DIR="/opt/truestock-universe/uploads"

# -----------------------------------------------------------------------------
# Social publishing (Stage 3) — ALL OPTIONAL. Leave unset and SeekPeak works
# exactly as before; the publish panel simply says it isn't configured.
# -----------------------------------------------------------------------------

# Upload-post API key — https://app.upload-post.com → Settings → API keys
# UPLOAD_POST_API_KEY=""

# The Upload-post profile ("user") whose connected accounts we post to.
# UPLOAD_POST_USER=""

# MASTER SWITCH for UNATTENDED publishing. Must be exactly "true" for the
# /api/cron/publish sweep to post anything. With it unset, scheduled content
# still shows on the calendar and can be published manually by an admin — the
# server just never posts on its own. Turn this on only when you are ready for
# SeekPeak to write to the company's live social accounts without a human
# watching. Manual "Publish now" is unaffected by this flag.
# PUBLISH_ENABLED="false"

# Node env
NODE_ENV="development"

# Sentry — optional. If unset, errors only land in stdout (still visible in DO logs).
# Install @sentry/node in apps/web to enable forwarding.
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
